# Frontend Environment Variables (.env)
# This file is for LOCAL DEVELOPMENT

# API Server Base URL
# Development: http://localhost:8090 (local API server)
# Production: https://your-railway-api.railway.app (deployed API)
VITE_API_BASE_URL=http://localhost:8090

# Base path for the application
BASE_PATH=/

# Development port (Vite server)
PORT=4173
