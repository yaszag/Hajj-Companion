# API Server Environment Variables (.env)
# This file is for LOCAL DEVELOPMENT

# Server Port
PORT=8090

# Node environment
NODE_ENV=development

# Database URL
# Local: postgresql://postgres:password@localhost:5432/hajj_db
# Railway: postgresql://... (provided by Railway)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hajj_db

# JWT Secret (use a random 32+ character string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-32-characters-minimum
